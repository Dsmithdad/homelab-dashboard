# Homelab Dashboard backend settings.
# Copy to backend/.env and edit. The systemd unit loads this file (EnvironmentFile=), so use plain
# KEY=value lines: no quotes, no spaces around "=", comments only on their own line.
# Every setting is optional; anything you leave out uses the default shown.

# --- Web server ---
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Home Assistant (Home Assistant page) ---
# Profile -> Security -> Long-lived access tokens
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
# Comma-separated entity domains to hide, e.g. update,button
HA_HIDDEN_DOMAINS=

# --- AI chat (Ollama) ---
OLLAMA_URL=http://localhost:11434

# --- Voice input (Whisper, see voice/docker-compose.yml) ---
WHISPER_URL=http://127.0.0.1:8100
WHISPER_MODEL=Systran/faster-whisper-small
WHISPER_LANGUAGE=en

# --- Weather for the AI chat and map tile (your town; a nearby city is fine) ---
WEATHER_PLACE=Kansas City, Missouri
WEATHER_LAT=39.0997
WEATHER_LON=-94.5786
WEATHER_TZ=America/Chicago

# --- Minecraft (Minecraft page/tile) ---
MC_HOST=127.0.0.1
MC_PORT=25565
# The address friends type in (shown on the page)
MC_PUBLIC_ADDRESS=
# Text that identifies the server's java process in `ps`
MC_PROCESS_MATCH=fabric-server-launch
# Server folder (holds world/, mods/, logs/)
MC_DIR=/path/to/minecraft/server
MC_LOG_PATH=/path/to/minecraft/server/logs/latest.log

# --- Drive health (Scrutiny) ---
SCRUTINY_URL=http://127.0.0.1:8085
SCRUTINY_PUBLIC_PORT=8085

# --- Backup tile (reads logs written by your own backup script) ---
BACKUP_LOG=/home/YOUR_USER/homelab/logs/immich-backup.log
BACKUP_CHECK_LOG=/home/YOUR_USER/homelab/logs/immich-backup-check.log
BACKUP_DB_DIR=/mnt/backup/immich/db
BACKUP_MOUNT=/mnt/backup
BACKUP_MAX_AGE_H=26

# --- God's Eye View tile (optional separate app) ---
GEV_URL=http://127.0.0.1:4173
GEV_PUBLIC_PORT=4173

# --- Files / Scripts / Cheat Sheets pages ---
# Colon-separated folders the Files page may browse
FILES_ROOTS=/home/YOUR_USER/homelab
SCRIPTS_DIR=/home/YOUR_USER/homelab/scripts
CHEATSHEET_DIR=/home/YOUR_USER/homelab/cheatsheets
CLAUDE_PROJECTS_DIR=/home/YOUR_USER/.claude/projects
